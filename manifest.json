{
    "manifest_version": 3,
    "name": "TextToMove",
    "version": "1.0.0.0",
    "description": "Type your chess moves instead of dragging them",
    "content_scripts": [
        {
            "matches": ["https://www.chess.com/*"], 
            "js": ["content.js"],
            "css": ["style.css"]
        }
    ]
}